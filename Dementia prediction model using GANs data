","class GeneratedDataset(Dataset):\n","    def __init__(self, image_paths, labels, transform=None):\n","        self.image_paths = image_paths\n","        self.labels = labels\n","        self.transform = transform\n","\n","    def __len__(self):\n","        return len(self.image_paths)\n","\n","    def __getitem__(self, idx):\n","        image_path = self.image_paths[idx]\n","        label = self.labels[idx]\n","        image = Image.open(image_path).convert('RGB')\n","        if self.transform:\n","            image = self.transform(image)\n","        return image, label\n","\n","# Paths to the generated images\n","generated_images_dir = '/content/generated_images'\n","\n","# Load the generated images\n","generated_images = []\n","generated_labels = []\n","for class_label, class_dir in [('Non Demented', 'non_demented'), ('Moderate Dementia', 'moderate_dementia')]:\n","    class_dir_path = os.path.join(generated_images_dir, class_dir)\n","    for img_file in os.listdir(class_dir_path):\n","        img_path = os.path.join(class_dir_path, img_file)\n","        generated_images.append(img_path)\n","        generated_labels.append(class_label)\n","\n","# Combine the datasets\n","all_images = dataset.images + generated_images\n","all_labels = dataset.labels + [0 if label == 'Moderate Dementia' else 1 for label in generated_labels]\n","\n","# Label encoding (already done, just combining)\n","label_encoder = {label: idx for idx, label in enumerate(['Moderate Dementia', 'Non Demented'])}\n","\n","# Create the combined dataset\n","combined_dataset = GeneratedDataset(image_paths=all_images, labels=all_labels, transform=transform)\n","combined_dataloader = DataLoader(combined_dataset, batch_size=64, shuffle=True)"],"metadata":{"id":"32iiNLMUJvne"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Instantiate a new model for the combined dataset training\n","model_combined = SimpleCNN()\n","\n","# Define criterion and optimizer\n","criterion_combined = nn.