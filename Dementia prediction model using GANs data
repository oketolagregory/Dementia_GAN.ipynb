AxZHx0YK"},"outputs":[],"source":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"FG5uAMLrxzt_"},"outputs":[],"source":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"gQ1gwd12xzah"},"outputs":[],"source":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Cx0qi0bOHlv4"},"outputs":[],"source":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"M66RkuUeGxzK"},"outputs":[],"source":[]},{"cell_type":"markdown","metadata":{"id":"yNzxZheDt2-9"},"source":["# Image Data Model\n"]},{"cell_type":"markdown","metadata":{"id":"nTMdtuJH3I3Q"},"source":["Libraries"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"xDdfO82W3Gpk"},"outputs":[],"source":["import os\n","import random\n","from PIL import Image\n","import torchvision.transforms as transforms\n","from torch.utils.data import Dataset, DataLoader\n","import torchvision\n","import torch\n","import torch.nn as nn\n","from torchvision.utils import save_image\n","import matplotlib.pyplot as plt\n","import torch.optim as optim\n","import torch.nn.functional as F"]},{"cell_type":"markdown","metadata":{"id":"hcggrRqB3Oko"},"source":["Data Loading and Preprocessing"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":29525,"status":"ok","timestamp":1716204195620,"user":{"displayName":"Gregory Oketola","userId":"13053235490742358740"},"user_tz":-60},"id":"dIEdC-d86Vjl","outputId":"ec236cfd-b4b4-49fd-b7e9-61eb27b8d6e4"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}],"source":["from google.colab import drive\n","drive.mount('/content/drive')"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"YWH5Uz5yNdBd"},"outputs":[],"source":["# Data Loading and Preprocessing\n","class MRIDataset(Dataset):\n","    def __init__(self, root_dir, transform=None, num_samples_per_class=250):\n","        self.root_dir = root_dir\n","        self.transform = transform\n","        self.classes = ['Non Demented', 'Moderate Dementia']\n","        self.images = []\n","        self.labels = []\n","\n","        for class_name in self.classes:\n","            class_dir = os.path.join(root_dir, class_name)\n","            if os.path.exists(class_dir):\n","                file_paths = [os.path.join(class_dir, file_name) for file_name in os.listdir(class_dir)]\n","                random_samples = random.sample(file_paths, min(num_samples_per_class, len(file_paths)))\n","                for file_path in random_samples:\n","                    self.images.append(file_path)\n","                    self.labels.append(self.classes.index(class_name))\n","\n","    def __len__(self):\n","        return len(self.images)\n","\n","    def __getitem__(self, idx):\n","        image_path = self.images[idx]\n","        label = self.labels[idx]\n","        image = Image.open(image_path).convert('RGB')\n","        if self.transform:\n","            image = self.transform(image)\n","        return image, label\n","\n","# Transform to tensor\n","transform = transforms.Compose([\n","    transforms.Resize((64, 64)),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.5, 0.5, 0.5], [0.5, 0.5, 0.5])\n","])\n","\n","# Create the dataset\n","dataset = MRIDataset(root_dir='/content/drive/MyDrive/Dementia_data', transform=transform, num_samples_per_class=488)\n","\n","# Create data loader\n","dataloader = DataLoader(dataset, batch_size=64, shuffle=True)\n"]},{"cell_type":"code","source":["from collections import Counter\n","\n","# Count the number of samples per class\n","class_counts = Counter()\n","for _, label in dataset:\n","    class_counts[label] += 1\n","\n","print(\"Class distribution:\")\n","for class_index, count in class_counts.items():\n","    print(f\"{dataset.classes[class_index]}: {count}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"id":"R4M0XWbb-0uY","executionInfo":{"status":"ok","timestamp":1716371467404,"user_tz":-60,"elapsed":355405,"user":{"displayName":"Gregory Oketola","userId":"13053235490742358740"}},"outputId":"476f3162-97bd-4fef-d502-ee6c6b0602f8"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Class distribution:\n","Non Demented: 488\n","Moderate Dementia: 488\n"]}]},{"cell_type":"code","source":["class SimpleCNN(nn.Module):\n","    def __init__(self):\n","        super(SimpleCNN, self).__init__()\n","        self.conv1 = nn.Conv2d(3, 32, kernel_size=3, stride=1, padding=1)\n","        self.conv2 = nn.Conv2d(32, 64, kernel_size=3, stride=1, padding=1)\n","        self.pool = nn.MaxPool2d(kernel_size=2, stride=2, padding=0)\n","        self.fc1 = nn.Linear(64 * 16 * 16, 128)\n","        self.fc2 = nn.Linear(128, 2)\n","        self.dropout = nn.Dropout(p=0.5)\n","\n","    def forward(self, x):\n","        x = self.pool(F.relu(self.conv1(x)))\n","        x = self.pool(F.relu(self.conv2(x)))\n","        x = x.view(-1, 64 * 16 * 16)\n","        x = F.relu(self.fc1(x))\n","        x = self.dropout(x)\n","        x = self.fc2(x)\n","        return x\n","\n","# Instantiate the model\n","model = SimpleCNN()\n"],"metadata":{"id":"XQtCMr2QIPSd"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Train Evaluate Plot"],"metadata":{"id":"SSmVqtxurhkY"}},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","from sklearn.metrics import accuracy_score, confusion_matrix\n","import seaborn as sns\n","\n","def train_model(model, dataloader, criterion, optimizer, num_epochs=500):\n","    model.train()\n","    train_losses = []\n","    train_accuracies = []\n","\n","    for epoch in range(num_epochs):\n","        running_loss = 0.0\n","        correct = 0\n","        total = 0\n","\n","        for images, labels in dataloader:\n","            optimizer.zero_grad()\n","            outputs = model(images)\n","            loss = criterion(outputs, labels)\n","            loss.backward()\n","            optimizer.step()\n","\n","            running_loss += loss.item()\n","            _, predicted = torch.max(outputs, 1)\n","            total += labels.size(0)\n","            correct += (predicted == labels).sum().item()\n","\n","        epoch_loss = running_loss / len(dataloader)\n","        epoch_accuracy = 100 * correct / total\n","        train_losses.append(epoch_loss)\n","        train_accuracies.append(epoch_accuracy)\n","\n","        if (epoch + 1) % 10 == 0:\n","            print(f\"Epoch {epoch+1}/{num_epochs}, Loss: {epoch_loss:.4f}, Accuracy: {epoch_accuracy:.2f}%\")\n","\n","    print(\"Finished Training\")\n","    return train_losses, train_accuracies\n","\n","def evaluate_model(model, dataloader):\n","    model.eval()\n","    all_labels = []\n","    all_predictions = []\n","    with torch.no_grad():\n","        for images, labels in dataloader:\n","            outputs = model(images)\n","            _, predicted = torch.max(outputs, 1)\n","            all_labels.extend(labels.cpu().numpy())\n","            all_predictions.extend(predicted.cpu().numpy())\n","\n","    accuracy = accuracy_score(all_labels, all_predictions)\n","    cm = confusion_matrix(all_labels, all_predictions)\n","\n","    print(f\"Accuracy: {accuracy:.2f}\")\n","\n","    plt.figure(figsize=(10, 5))\n","    sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", xticklabels=['Moderate Dementia', 'Non Demented'], yticklabels=['Moderate Dementia', 'Non Demented'])\n","    plt.xlabel('Predicted')\n","    plt.ylabel('True')\n","    plt.title('Confusion Matrix')\n","    plt.show()\n","\n","    return accuracy, cm\n","\n","def plot_metrics(train_losses, train_accuracies):\n","    plt.figure(figsize=(12, 5))\n","\n","    plt.subplot(1, 2, 1)\n","    plt.plot(train_losses, label='Training Loss')\n","    plt.xlabel('Epochs')\n","    plt.ylabel('Loss')\n","    plt.title('Training Loss')\n","    plt.legend()\n","\n","    plt.subplot(1, 2, 2)\n","    plt.plot(train_accuracies, label='Training Accuracy')\n","    plt.xlabel('Epochs')\n","    plt.ylabel('Accuracy')\n","    plt.title('Training Accuracy')\n","    plt.legend()\n","\n","    plt.show()\n"],"metadata":{"id":"xUK_3kFFRDU4"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Define criterion and optimizer\n","criterion = nn.CrossEntropyLoss()\n","optimizer = optim.Adam(model.parameters(), lr=0.001)\n","\n","# Train the model on the original dataset\n","train_losses, train_accuracies = train_model(model, dataloader, criterion, optimizer, num_epochs=20)\n","\n","# Plot training metrics\n","plot_metrics(train_losses, train_accuracies)\n","\n","# Evaluate the model on the original dataset\n","original_accuracy, original_cm = evaluate_model(model, dataloader)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"_oe29dxORMrn","executionInfo":{"status":"ok","timestamp":1716282282610,"user_tz":-60,"elapsed":608440,"user":{"displayName":"Gregory Oketola","userId":"13053235490742358740"}},"outputId":"afb877fb-04f7-4057-ef0c-0248ced0a260"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 10/20, Loss: 0.0019, Accuracy: 100.00%\n","Epoch 20/20, Loss: 0.0011, Accuracy: 100.00%\n","Finished Training\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Accuracy: 1.00\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":[],"metadata":{"id":"3fPiwYKDIVKz"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## Deep Convolutional (DC)GAN"],"metadata":{"id":"GHfDR4okXJnU"}},{"cell_type":"markdown","metadata":{"id":"aAGxKqWb3TKP"},"source":["Function to save generated images after a defined number of iterations"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"ThfoluR4WbEY"},"outputs":[],"source":["def save_generated_images(images, epoch, save_dir, label, num_images_per_class):\n","    if epoch >= start_saving_epoch:\n","        label_dir = os.path.join(save_dir, \"non_demented\" if label == 0 else \"moderate_dementia\")\n","        os.makedirs(label_dir, exist_ok=True)\n","        for i, image in enumerate(images[:num_images_per_class]):\n","            # Denormalize the image\n","            image = (image + 1) / 2  # Assuming normalization in the range [-1, 1]\n","            image_path = os.path.join(label_dir, f'epoch_{epoch}_sample_{i}.png')\n","            save_image(image, image_path)\n","\n","save_dir = 'generated_images'\n","os.makedirs(save_dir, exist_ok=True)"]},{"cell_type":"markdown","metadata":{"id":"wUwK6Y7R3i1V"},"source":["Generator and Discriminator Networks\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"SWTDll3D3omO"},"outputs":[],"source":["# Generator and Discriminator Networks\n","class Generator(nn.Module):\n","    def __init__(self, latent_dim, channels):\n","        super(Generator, self).__init__()\n","        self.main = nn.Sequential(\n","            nn.ConvTranspose2d(latent_dim, 512, 4, 1, 0, bias=False),\n","            nn.BatchNorm2d(512),\n","            nn.ReLU(True),\n","            nn.ConvTranspose2d(512, 256, 4, 2, 1, bias=False),\n","            nn.BatchNorm2d(256),\n","            nn.ReLU(True),\n","            nn.ConvTranspose2d(256, 128, 4, 2, 1, bias=False),\n","            nn.BatchNorm2d(128),\n","            nn.ReLU(True),\n","            nn.ConvTranspose2d(128, 64, 4, 2, 1, bias=False),\n","            nn.BatchNorm2d(64),\n","            nn.ReLU(True),\n","            nn.ConvTranspose2d(64, channels, 4, 2, 1, bias=False),\n","            nn.Tanh()\n","        )\n","\n","    def forward(self, noise):\n","        return self.main(noise)\n","\n","class Discriminator(nn.Module):\n","    def __init__(self, channels=3):\n","        super(Discriminator, self).__init__()\n","        self.main = nn.Sequential(\n","            nn.Conv2d(channels, 64, 4, 2, 1, bias=False),\n","            nn.LeakyReLU(0.2, inplace=True),\n","            nn.Conv2d(64, 128, 4, 2, 1, bias=False),\n","            nn.BatchNorm2d(128),\n","            nn.LeakyReLU(0.2, inplace=True),\n","            nn.Conv2d(128, 256, 4, 2, 1, bias=False),\n","            nn.BatchNorm2d(256),\n","            nn.LeakyReLU(0.2, inplace=True),\n","            nn.Conv2d(256, 512, 4, 2, 1, bias=False),\n","            nn.BatchNorm2d(512),\n","            nn.LeakyReLU(0.2, inplace=True),\n","            nn.Conv2d(512, 1, 4, 1, 0, bias=False),\n","            nn.Sigmoid()\n","        )\n","\n","    def forward(self, image):\n","        return self.main(image)\n"]},{"cell_type":"markdown","metadata":{"id":"snJuyVFv3r_d"},"source":["Hyperparameters"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"00SkA6dl3uLB"},"outputs":[],"source":["# Parameter tuning is informed by testings and observations\n","\n","latent_dim = 100    # Dimension of the noise vector\n","channels = 3        # Number of channels in the MRI images (RGB)\n","lr = 0.0002         # Learning rate\n","batch_size = 64\n","num_epochs = 500\n","start_saving_epoch = 400      # Start saving images after this epoch\n","num_images_per_class = 100   # Number of images per class to save\n","eval_interval = 10            # Interval (in epochs) for evaluating and visualizing generated images\n","\n","\n","# Initialize models\n","generator = Generator(latent_dim, channels)\n","discriminator = Discriminator(channels)\n","\n","# Loss function and optimizers\n","criterion = nn.BCELoss()\n","g_optimizer = torch.optim.Adam(generator.parameters(), lr=lr, betas=(0.5, 0.999))\n","d_optimizer = torch.optim.Adam(discriminator.parameters(), lr=lr, betas=(0.5, 0.999))"]},{"cell_type":"markdown","metadata":{"id":"kbH1-sQ24d0d"},"source":["Training loop"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1v1CucDMv0wnZcEXbGSvYZFrTFUFiFT20"},"collapsed":true,"id":"Tsn3S2ZINRNR","outputId":"44ee6ed4-854e-4277-d372-f0c88df7bfe5","executionInfo":{"status":"ok","timestamp":1716285517753,"user_tz":-60,"elapsed":3235145,"user":{"displayName":"Gregory Oketola","userId":"13053235490742358740"}}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}],"source":["%%time\n","# Training loop\n","for epoch in range(num_epochs):\n","    for real_images, real_labels in dataloader:\n","        # Real images\n","        real_images = real_images\n","        real_labels = torch.ones(real_images.size(0), 1, 1, 1)\n","\n","        # Noise for generating fake images\n","        noise = torch.randn(real_images.size(0), latent_dim, 1, 1)\n","\n","        # Train the discriminator\n","        d_optimizer.zero_grad()\n","        fake_images = generator(noise)\n","        fake_labels = torch.zeros(real_images.size(0), 1, 1, 1)\n","        real_loss = criterion(discriminator(real_images), real_labels)\n","        fake_loss = criterion(discriminator(fake_images.detach()), fake_labels)\n","        d_loss = real_loss + fake_loss\n","        d_loss.backward()\n","        d_optimizer.step()\n","\n","        # Train the generator\n","        g_optimizer.zero_grad()\n","        generated_labels = torch.ones(real_images.size(0), 1, 1, 1)\n","        g_loss = criterion(discriminator(fake_images), generated_labels)\n","        g_loss.backward()\n","        g_optimizer.step()\n","\n","    # Evaluate and visualize generated images\n","    if (epoch + 1) % eval_interval == 0:\n","        print(f\"Epoch [{epoch + 1}/{num_epochs}], d_loss: {d_loss.item():.4f}, g_loss: {g_loss.item():.4f}\")\n","        with torch.no_grad():\n","            noise = torch.randn(16, latent_dim, 1, 1)\n","            generated_images = generator(noise).detach().cpu()\n","            grid = torchvision.utils.make_grid(generated_images, nrow=4, normalize=True)\n","            plt.imshow(grid.permute(1, 2, 0))\n","            plt.show()\n","\n","    # Save generated images after the specified epoch\n","    if epoch >= start_saving_epoch:\n","        with torch.no_grad():\n","            noise = torch.randn(num_images_per_class * 2, latent_dim, 1, 1)\n","            fake_images = generator(noise).detach().cpu()\n","            save_generated_images(fake_images[:num_images_per_class], epoch, save_dir, 0, num_images_per_class)\n","            save_generated_images(fake_images[num_images_per_class:], epoch, save_dir, 1, num_images_per_class)\n","\n","        # Save generated images after the specified epoch\n","        #if epoch >= start_saving_epoch:\n","         #   save_generated_images(fake_images, epoch, 'generated_images/non_demented', 0, num_images_per_class)\n","          #  save_generated_images(fake_images, epoch, 'generated_images/moderate_dementia', 1, num_images_per_class)"]},{"cell_type":"markdown","metadata":{"id":"L5Kar1bv4xq4"},"source":["### Preprocess and test"]},{"cell_type":"code","source":["import os\n","from PIL import Image\n","import matplotlib.pyplot as plt\n","import numpy as np\n","\n","# Set the path to the generated images directory\n","generated_images_dir = 'generated_images'\n","\n","# Count the number of images in each subdirectory\n","num_non_demented = len(os.listdir(os.path.join(generated_images_dir, 'non_demented')))\n","num_moderate_dementia = len(os.listdir(os.path.join(generated_images_dir, 'moderate_dementia')))\n","\n","print(f\"Number of non-demented images: {num_non_demented}\")\n","print(f\"Number of moderate dementia images: {num_moderate_dementia}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6iz9fXSs_Def","executionInfo":{"status":"ok","timestamp":1716285517753,"user_tz":-60,"elapsed":14,"user":{"displayName":"Gregory Oketola","userId":"13053235490742358740"}